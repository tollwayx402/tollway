{
  "name": "@tollway/ingest",
  "version": "0.1.0",
  "description": "Tollway cloud event client: batches events to ingest.tollway.sh, and polls signed remote config.",
  "license": "BUSL-1.1",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@tollway/core": "workspace:*"
  },
  "devDependencies": {
    "@tollway/core": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tollwayx402/tollway.git",
    "directory": "packages/ingest"
  },
  "homepage": "https://github.com/tollwayx402/tollway#readme",
  "bugs": "https://github.com/tollwayx402/tollway/issues"
}
