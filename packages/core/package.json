{
  "name": "@tollway/core",
  "version": "0.1.0",
  "description": "Framework-agnostic x402 toll gate: challenges, verification pipeline, receipts, events, replay protection.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "PROTOCOL.md",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "x402": "1.2.0"
  }
}
