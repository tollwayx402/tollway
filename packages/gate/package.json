{
  "name": "@octroi/gate",
  "version": "0.1.0",
  "description": "Batteries-included Octroi: core + Express + the Coinbase facilitator, and the `doctor` CLI.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "octroi": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./doctor": {
      "types": "./dist/doctor.d.ts",
      "default": "./dist/doctor.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@octroi/coinbase": "workspace:*",
    "@octroi/core": "workspace:*",
    "@octroi/express": "workspace:*"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    },
    "x402-fetch": {
      "optional": true
    }
  },
  "peerDependencies": {
    "viem": ">=2.23",
    "x402-fetch": ">=1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3",
    "viem": "2.55.13",
    "vitest": "^3.2.4",
    "x402-fetch": "1.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octroihq/octroi.git",
    "directory": "packages/gate"
  },
  "homepage": "https://github.com/octroihq/octroi#readme",
  "bugs": "https://github.com/octroihq/octroi/issues"
}
