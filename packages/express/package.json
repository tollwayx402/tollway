{
  "name": "@octroi/express",
  "version": "0.1.0",
  "description": "Express middleware for Octroi: gate a route behind an x402 toll.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@octroi/core": "workspace:*"
  },
  "peerDependencies": {
    "express": ">=4.18",
    "@octroi/ingest": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "express": "^5.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@octroi/ingest": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@octroi/ingest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octroihq/octroi.git",
    "directory": "packages/express"
  },
  "homepage": "https://github.com/octroihq/octroi#readme",
  "bugs": "https://github.com/octroihq/octroi/issues"
}
